APP_NAME=Tattoo AI API
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
APP_LOG_LEVEL=info
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
TATTOO_EXTRACTOR_ROOT=api_server/vendor/inklift_v11_7
MODEL_LOAD_ON_STARTUP=true
MAX_UPLOAD_MB=20
TATTOO_GENERATOR_ROOT=api_server/vendor/tattoo_generator_sd15
GENERATOR_LOAD_ON_STARTUP=false
TATTOO_CLASSIFIER_ROOT=api_server/vendor/tattoo_classifier_v3
CLASSIFIER_LOAD_ON_STARTUP=false
GPU_LOW_VRAM_MODE=false
GENERATOR_CPU_OFFLOAD=false
GENERATOR_UNLOAD_AFTER_REQUEST=false
