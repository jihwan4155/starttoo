FROM python:3.11-slim

ARG TORCH_VERSION=2.12.1
ARG TORCHVISION_VERSION=0.27.1
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/app \
    HF_HOME=/home/app/.cache/huggingface \
    TOKENIZERS_PARALLELISM=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home app

COPY api_server/requirements.txt /tmp/api-server-requirements.txt

RUN pip install --no-cache-dir \
        --index-url "${TORCH_INDEX_URL}" \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}"

RUN pip install --no-cache-dir -r /tmp/api-server-requirements.txt

ENV PYTHONDONTWRITEBYTECODE=1

COPY api_server /app/api_server

RUN mkdir -p \
        /app/api_server/runtime \
        /app/api_server/vendor/tattoo_generator_sd15/models/stable-diffusion-v1-5 \
        /app/api_server/vendor/tattoo_classifier_v3/siglip2-so400m-patch16-384 \
        /home/app/.cache/huggingface \
    && chown -R app:app /app /home/app

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 \
    CMD python -c "import json,sys,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)); sys.exit(0 if d['pipeline_status']=='ready' and d['status']!='degraded' else 1)"

CMD ["python", "-m", "api_server"]
