# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 git에 올라가지 않는다)
#
# ⚠️ VITE_ 로 시작하는 값은 빌드 시 브라우저 번들에 그대로 박힌다.
#    사용자가 개발자 도구로 전부 볼 수 있으므로 비밀 값은 절대 넣지 않는다.
#    REST API 키 · client secret · JWT 비밀키는 백엔드 .env 에만 둔다.

# ── 백엔드 연결 ─────────────────────────────────────────────
# 배포 백엔드를 쓸 때. 로컬 백엔드면 두 줄 다 지운다 (기본값 http://localhost:8080/v1)
# 배포 서버 CORS가 http://localhost:5173만 허용하는데 dev 서버는 https라서
# 직접 호출하면 403이 된다. 그래서 vite dev 프록시를 거친다.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=https://starttoo.duckdns.org

# ── 소셜 로그인 ─────────────────────────────────────────────
# 카카오 개발자 콘솔 > 앱 키 > "JavaScript 키"  (REST API 키 아님!)
# 이 키는 브라우저에 노출되는 것이 정상이며, 등록된 도메인에서만 동작한다.
# 콘솔에 함께 등록할 것:
#   [앱 키 > JavaScript SDK 도메인]   : https://localhost:5173
#                                      https://starttoo.duckdns.org
#   [카카오 로그인 > Redirect URI]    : https://localhost:5173/oauth/kakao/callback
#                                      https://starttoo.duckdns.org/oauth/kakao/callback
#   [카카오 로그인] 활성화 ON
# 도메인을 등록하지 않으면 JavaScript 키 자체가 동작하지 않는다.
VITE_KAKAO_JS_KEY=

# ── 도안 추출 서버 (선택) ────────────────────────────────────
# 미설정 시 http://127.0.0.1:8791
# VITE_EXTRACT_API_BASE_URL=
