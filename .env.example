# Copy this file to .env and fill secrets for local or deployment use.

JWT_SECRET=change-me

POSTGRES_DB=starttoo
POSTGRES_USER=starttoo
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=

MINIO_ROOT_USER=starttoo
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=starttoo
MAX_IMAGE_BYTES=15728640
# presigned URL에 실제로 찍히는 외부 접근 주소. 운영에서는 storage 서브도메인의 https 주소로 설정한다.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# CORS/WebSocket에 허용할 프론트엔드 origin (쉼표로 여러 개 구분 가능).
# 운영에서는 실제 서비스 도메인으로 설정한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

AI_BASE_URL=http://ai:8000
AI_ENABLED=false

SMS_WEBHOOK_URL=
SMS_API_KEY=

FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

SWAGGER_ENABLED=false
