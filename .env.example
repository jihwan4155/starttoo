# Copy this file to .env and fill secrets for local or deployment use.

JWT_SECRET=change-me

POSTGRES_DB=starttoo
POSTGRES_USER=starttoo
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=

MINIO_ROOT_USER=starttoo
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=starttoo
MAX_IMAGE_BYTES=15728640
# presigned URL에 실제로 찍히는 외부 접근 주소. 운영에서는 storage 서브도메인의 https 주소로 설정한다.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# CORS/WebSocket에 허용할 프론트엔드 origin (쉼표로 여러 개 구분 가능).
# 운영에서는 실제 서비스 도메인으로 설정한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

AI_BASE_URL=http://ai:8000
AI_ENABLED=false

# 커버업 도안 검색 엔진 (ai 컨테이너). AI_* 와는 다른 기능이다.
COVERUP_ENABLED=false
COVERUP_ENGINE_URL=http://ai:8000
# backend 와 ai 가 공유하는 내부 토큰. nginx 가 /ai-service/ 를 공개로 열어 두므로
# 이 값이 비어 있으면 누구나 검색을 호출할 수 있다(CPU 무제한). 운영에서는 반드시 채운다.
COVERUP_INTERNAL_TOKEN=
# 색인 정합성 스캔 주기 (기본 10분). 색인 누락·잔존을 복구한다.
COVERUP_INDEX_SYNC_CRON=0 */10 * * * *
# auto = 도안 3만 장 초과 시 1단계 후보 추림 자동 활성. on/off 로 고정할 수도 있다.
COVERUP_STAGE1=auto
# 엔진의 동시 검색 상한. 검색은 CPU 바운드다.
COVERUP_MAX_CONCURRENT=3

SMS_WEBHOOK_URL=
SMS_API_KEY=

FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

SWAGGER_ENABLED=false
